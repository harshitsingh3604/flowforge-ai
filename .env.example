# Client

VITE_NHOST_SUBDOMAIN=your-subdomain
VITE_NHOST_REGION=your-region
VITE_NHOST_GRAPHQL_URL=https://your-subdomain.graphql.your-region.nhost.run/v1
VITE_NHOST_GRAPHQL_WS_URL=wss://your-subdomain.graphql.your-region.nhost.run/v1

# Server
PORT=5000
HASURA_GRAPHQL_URL=https://your-subdomain.graphql.your-region.nhost.run/v1
HASURA_ADMIN_SECRET=your-hasura-admin-secret
GEMINI_MODEL=your-gemini-model
GEMINI_API_KEY=your-gemini-api-key
CORS_ORIGINS=your-allowed-origins
FLOWFORGE_EVENT_SECRET=your-flowforge-event-secret
SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=30000